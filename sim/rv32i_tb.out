#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5cfc1511f180 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5cfc1511f310 .scope module, "tb_rv32i_core" "tb_rv32i_core" 3 3;
 .timescale -9 -12;
v0x5cfc151307f0_0 .var "clk", 0 0;
v0x5cfc15130890_0 .var "rst", 0 0;
S_0x5cfc150e5490 .scope module, "dut" "rv32i_core" 3 8, 4 1 0, S_0x5cfc1511f310;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 32 "pc";
v0x5cfc1510bd70_0 .net "clk", 0 0, v0x5cfc151307f0_0;  1 drivers
v0x5cfc1510c150_0 .var "pc", 31 0;
v0x5cfc151306d0_0 .net "rst", 0 0, v0x5cfc15130890_0;  1 drivers
E_0x5cfc150e5fc0 .event posedge, v0x5cfc1510bd70_0;
    .scope S_0x5cfc150e5490;
T_0 ;
    %wait E_0x5cfc150e5fc0;
    %load/vec4 v0x5cfc151306d0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x5cfc1510c150_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5cfc1510c150_0;
    %addi 4, 0, 32;
    %assign/vec4 v0x5cfc1510c150_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5cfc1511f310;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5cfc151307f0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x5cfc1511f310;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5cfc151307f0_0;
    %inv;
    %store/vec4 v0x5cfc151307f0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5cfc1511f310;
T_3 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5cfc15130890_0, 0, 1;
    %pushi/vec4 2, 0, 32;
T_3.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.1, 5;
    %jmp/1 T_3.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x5cfc150e5fc0;
    %jmp T_3.0;
T_3.1 ;
    %pop/vec4 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5cfc15130890_0, 0, 1;
    %pushi/vec4 20, 0, 32;
T_3.2 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_3.3, 5;
    %jmp/1 T_3.3, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x5cfc150e5fc0;
    %jmp T_3.2;
T_3.3 ;
    %pop/vec4 1;
    %vpi_call/w 3 23 "$display", "RV32I CORE TEST COMPLETE" {0 0 0};
    %vpi_call/w 3 24 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/tb_rv32i_core.sv";
    "rtl/rv32i_core.sv";
